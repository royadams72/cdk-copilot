{
  "collMod": "patient_goals_ledger",
  "indexes": [
    {
      "key": { "patientId": 1, "createdAt": -1 },
      "name": "byPatientCreatedAt"
    },
    {
      "key": { "goalCode": 1, "createdAt": -1 },
      "name": "byGoalCodeCreatedAt"
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "patientId",
        "goalCode",
        "eventType",
        "createdAt",
        "createdBy",
        "before",
        "after"
      ],
      "properties": {
        "patientId": { "bsonType": "objectId" },
        "orgId": { "bsonType": ["string", "null"] },
        "goalCode": {
          "enum": [
            "weight_loss",
            "weight_maintenance",
            "weight_gain",
            "reduce_phosphorus",
            "reduce_potassium",
            "reduce_sodium",
            "increase_protein",
            "improve_energy",
            "better_meal_routine",
            "general_health"
          ]
        },
        "eventType": {
          "enum": [
            "patient_selected",
            "patient_deselected",
            "care_team_added",
            "care_team_updated",
            "care_team_override_set",
            "care_team_override_cleared",
            "care_team_lock_set",
            "care_team_lock_cleared",
            "goal_completed",
            "goal_archived"
          ]
        },
        "createdAt": { "bsonType": "date" },
        "createdBy": {
          "bsonType": "object",
          "required": ["actorType", "principalId"],
          "properties": {
            "actorType": { "enum": ["patient", "clinician", "dietitian", "admin", "system"] },
            "displayName": { "bsonType": ["string", "null"] },
            "principalId": { "bsonType": "string" }
          }
        },
        "reason": { "bsonType": ["string", "null"] },
        "before": { "bsonType": ["object", "null"] },
        "after": { "bsonType": ["object", "null"] }
      }
    }
  }
}
