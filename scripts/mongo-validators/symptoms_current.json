{
  "collMod": "symptoms_current",
  "indexes": [
    {
      "key": { "patientId": 1, "symptomId": 1 },
      "options": { "name": "uniq_byPatientSymptomId", "unique": true }
    },
    {
      "key": { "patientId": 1, "status": 1, "updatedAt": -1 },
      "options": { "name": "byPatientStatusUpdatedAt" }
    },
    {
      "key": { "patientId": 1, "normalizedName": 1, "updatedAt": -1 },
      "options": { "name": "byPatientNormalizedNameUpdatedAt" }
    },
    {
      "key": { "orgId": 1, "patientId": 1, "status": 1, "updatedAt": -1 },
      "options": {
        "name": "byOrgPatientStatusUpdatedAt",
        "partialFilterExpression": { "orgId": { "$type": "string" } }
      }
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "patientId",
        "symptomId",
        "name",
        "normalizedName",
        "severity",
        "recordedAt",
        "status",
        "triggers",
        "source",
        "createdAt",
        "createdBy",
        "updatedAt",
        "updatedBy"
      ],
      "properties": {
        "_id": { "bsonType": "objectId" },
        "patientId": { "bsonType": "objectId" },
        "symptomId": { "bsonType": "string" },
        "orgId": { "bsonType": ["string", "null"] },
        "name": { "bsonType": "string" },
        "normalizedName": {
          "bsonType": "string",
          "pattern": "^[a-z0-9][a-z0-9\\s/-]*$"
        },
        "severity": { "bsonType": ["int", "long"] },
        "recordedAt": { "bsonType": "date" },
        "startedAt": { "bsonType": ["date", "null"] },
        "resolvedAt": { "bsonType": ["date", "null"] },
        "status": { "enum": ["active", "improving", "resolved"] },
        "note": { "bsonType": ["string", "null"] },
        "triggers": {
          "bsonType": "array",
          "items": { "bsonType": "string" }
        },
        "source": {
          "enum": ["patient", "clinician", "dietitian", "admin", "system"]
        },
        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" },
        "createdBy": {
          "bsonType": "object",
          "required": ["actorType", "principalId"],
          "properties": {
            "actorType": {
              "enum": ["patient", "clinician", "dietitian", "admin", "system"]
            },
            "displayName": { "bsonType": ["string", "null"] },
            "principalId": { "bsonType": "string" }
          },
          "additionalProperties": false
        },
        "updatedBy": {
          "bsonType": "object",
          "required": ["actorType", "principalId"],
          "properties": {
            "actorType": {
              "enum": ["patient", "clinician", "dietitian", "admin", "system"]
            },
            "displayName": { "bsonType": ["string", "null"] },
            "principalId": { "bsonType": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
