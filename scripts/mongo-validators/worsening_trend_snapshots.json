{
  "collMod": "worsening_trend_snapshots",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "body",
        "checkInResponseCode",
        "checkInResponseLabel",
        "checkInSubmittedAt",
        "detail",
        "episodeId",
        "firstDetectedAt",
        "href",
        "key",
        "lastDetectedAt",
        "level",
        "patientId",
        "portalEscalationEligible",
        "reviewedByPrincipalId",
        "reviewedByRole",
        "screen",
        "status",
        "title",
        "updatedAt"
      ],
      "properties": {
        "_id": { "bsonType": "objectId" },
        "body": { "bsonType": "string" },
        "checkInResponseCode": { "bsonType": ["string", "null"] },
        "checkInResponseLabel": { "bsonType": ["string", "null"] },
        "checkInSubmittedAt": { "bsonType": ["date", "null"] },
        "detail": { "bsonType": ["string", "null"] },
        "episodeId": { "bsonType": "string" },
        "firstDetectedAt": { "bsonType": "date" },
        "href": { "bsonType": ["string", "null"] },
        "key": {
          "bsonType": "string",
          "enum": [
            "blood_pressure_up",
            "nutrition_worsening",
            "steps_decline",
            "symptoms_worsening",
            "weight_decrease",
            "weight_increase"
          ]
        },
        "lastDetectedAt": { "bsonType": "date" },
        "level": {
          "bsonType": "string",
          "enum": [
            "level_1_nudge",
            "level_2_check_in",
            "level_3_escalate",
            "level_3_high_priority"
          ]
        },
        "patientId": { "bsonType": "objectId" },
        "portalEscalationEligible": { "bsonType": "bool" },
        "resolvedAt": { "bsonType": ["date", "null"] },
        "reviewedAt": { "bsonType": ["date", "null"] },
        "reviewedByPrincipalId": { "bsonType": ["string", "null"] },
        "reviewedByRole": { "bsonType": ["string", "null"] },
        "screen": { "bsonType": "string" },
        "status": {
          "bsonType": "string",
          "enum": ["active", "resolved"]
        },
        "title": { "bsonType": "string" },
        "updatedAt": { "bsonType": "date" },
        "viewedAt": { "bsonType": ["date", "null"] }
      },
      "additionalProperties": false
    }
  },
  "validationLevel": "moderate",
  "validationAction": "error",
  "indexes": [
    {
      "key": { "patientId": 1, "episodeId": 1 },
      "options": { "unique": true, "name": "uniq_patient_episode" }
    },
    {
      "key": { "patientId": 1, "status": 1, "reviewedAt": 1, "updatedAt": -1 },
      "options": { "name": "byPatientPortalStatus" }
    },
    {
      "key": { "patientId": 1, "reviewedAt": -1, "updatedAt": -1 },
      "options": { "name": "byPatientReviewedAt" }
    }
  ]
}
