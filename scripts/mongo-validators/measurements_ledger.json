{
  "collMod": "measurements_ledger",
  "indexes": [
    {
      "key": { "patientId": 1, "kind": 1, "measuredAt": -1 },
      "options": { "name": "byPatientKind_latest" }
    },
    {
      "key": { "patientId": 1, "measuredAt": -1 },
      "options": { "name": "byPatient_time" }
    },
    {
      "key": { "orgId": 1, "patientId": 1, "kind": 1, "measuredAt": -1 },
      "options": { "name": "byOrgPatientKind_time" }
    },
    {
      "key": {
        "orgId": 1,
        "patientId": 1,
        "kind": 1,
        "device.externalId": 1,
        "measuredAt": 1
      },
      "options": {
        "name": "dedupe_byDevice_ext_measuredAt",
        "unique": true,
        "partialFilterExpression": { "device.externalId": { "$exists": true } }
      }
    },
    {
      "key": {
        "orgId": 1,
        "patientId": 1,
        "kind": 1,
        "provider.packageName": 1,
        "externalRecordId": 1
      },
      "options": {
        "name": "dedupe_byProvider_externalRecordId",
        "unique": true,
        "partialFilterExpression": {
          "provider.packageName": { "$exists": true },
          "externalRecordId": { "$exists": true }
        }
      }
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "kind",
        "patientId",
        "orgId",
        "measuredAt",
        "receivedAt",
        "source",
        "createdBy",
        "updatedBy"
      ],
      "properties": {
        "_id": { "bsonType": "objectId" },
        "kind": {
          "enum": [
            "weight",
            "blood_pressure",
            "heart_rate",
            "steps",
            "exercise",
            "sleep"
          ]
        },
        "patientId": { "bsonType": "objectId" },
        "orgId": { "bsonType": "string" },
        "measuredAt": { "bsonType": "date" },
        "receivedAt": { "bsonType": "date" },
        "source": { "enum": ["patient", "device", "api", "provider"] },
        "provider": {
          "bsonType": "object",
          "required": ["packageName"],
          "properties": {
            "packageName": { "bsonType": "string" },
            "displayName": { "bsonType": "string" }
          },
          "additionalProperties": false
        },
        "externalRecordId": { "bsonType": "string" },
        "sync": {
          "bsonType": "object",
          "required": ["provider", "status"],
          "properties": {
            "provider": { "enum": ["health_connect"] },
            "dayKey": { "bsonType": "string" },
            "status": { "enum": ["provisional", "finalized"] },
            "lastReconciledAt": { "bsonType": "date" },
            "finalizedAt": { "bsonType": "date" }
          },
          "additionalProperties": false
        },
        "device": {
          "bsonType": "object",
          "properties": {
            "name": { "bsonType": "string" },
            "platform": { "bsonType": "string" },
            "externalId": { "bsonType": "string" }
          },
          "additionalProperties": false
        },
        "notes": { "bsonType": "string" },
        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" },
        "createdBy": { "bsonType": "string" },
        "updatedBy": { "bsonType": "string" },

        "valueKg": { "bsonType": ["double", "int", "long", "decimal"] },
        "systolicMmHg": { "bsonType": ["int", "long", "double", "decimal"] },
        "diastolicMmHg": { "bsonType": ["int", "long", "double", "decimal"] },
        "pulseBpm": { "bsonType": ["int", "long", "double", "decimal"] },
        "bpm": { "bsonType": ["int", "long", "double", "decimal"] },
        "count": { "bsonType": ["int", "long", "double", "decimal"] },
        "caloriesKcal": { "bsonType": ["int", "long", "double", "decimal"] },
        "distanceMeters": { "bsonType": ["int", "long", "double", "decimal"] },
        "averageSpeedKph": { "bsonType": ["int", "long", "double", "decimal"] },
        "durationMin": { "bsonType": ["int", "long", "double", "decimal"] },
        "sleepFromAt": { "bsonType": "date" },
        "sleepToAt": { "bsonType": "date" },
        "steps": {
          "bsonType": "object",
          "properties": {
            "averageSpeedKph": { "bsonType": ["int", "long", "double", "decimal"] },
            "caloriesKcal": { "bsonType": ["int", "long", "double", "decimal"] },
            "distanceMeters": { "bsonType": ["int", "long", "double", "decimal"] }
          },
          "additionalProperties": false
        },
        "exercise": {
          "bsonType": "object",
          "required": [
            "exerciseId",
            "title",
            "name",
            "category",
            "intensity",
            "met",
            "durationMin",
            "caloriesKcal"
          ],
          "properties": {
            "exerciseId": { "bsonType": "string" },
            "title": { "bsonType": "string" },
            "name": { "bsonType": "string" },
            "category": { "bsonType": "string" },
            "intensity": { "enum": ["light", "moderate", "vigorous"] },
            "met": { "bsonType": ["double", "int", "long", "decimal"] },
            "durationMin": { "bsonType": ["int", "long", "double", "decimal"] },
            "caloriesKcal": { "bsonType": ["int", "long", "double", "decimal"] }
          },
          "additionalProperties": false
        },
        "quality": { "enum": ["poor", "fair", "good", "excellent"] }
      },
      "anyOf": [
        {
          "properties": {
            "kind": {
              "enum": ["weight", "blood_pressure", "heart_rate", "steps", "exercise"]
            }
          }
        },
        { "required": ["durationMin", "sleepFromAt", "sleepToAt"] }
      ],
      "additionalProperties": false
    }
  }
}
