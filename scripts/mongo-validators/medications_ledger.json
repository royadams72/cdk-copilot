{
  "collMod": "medications_ledger",
  "indexes": [
    {
      "key": { "patientId": 1, "medicationId": 1, "at": 1 },
      "options": { "name": "byPatient_medication_eventTime" }
    },
    {
      "key": { "patientId": 1, "at": -1 },
      "options": { "name": "byPatient_recentEvents" }
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "patientId",
        "medicationId",
        "eventType",
        "at",
        "by"
      ],
      "properties": {
        "orgId": { "bsonType": "string" },
        "patientId": { "bsonType": "objectId" },
        "medicationId": { "bsonType": "objectId" },
        "eventType": {
          "enum": [
            "created",
            "name_changed",
            "dose_changed",
            "frequency_changed",
            "route_changed",
            "form_changed",
            "startAt_changed",
            "instructions_changed",
            "dmplusdCode_changed",
            "snomedCode_changed",
            "drugRefId_changed",
            "status_changed"
          ]
        },
        "at": { "bsonType": "date" },
        "by": { "bsonType": "string" },
        "reason": { "bsonType": "string" },
        "data": { "bsonType": "object" }
      },
      "additionalProperties": true
    }
  }
}
