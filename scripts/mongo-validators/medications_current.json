{
  "collMod": "medications_current",
  "indexes": [
    {
      "key": { "patientId": 1, "status": 1, "startAt": -1 },
      "options": { "name": "byPatient_status_startAt" }
    },
    {
      "key": { "patientId": 1, "medicationId": 1 },
      "options": { "name": "uniqPatient_medication", "unique": true }
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
