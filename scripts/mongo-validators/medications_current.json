        "medicationId": { "bsonType": "objectId" },
        "name": { "bsonType": "string" },
        "dose": { "bsonType": "string" },
        "frequency": { "bsonType": "string" },
        "route": { "bsonType": "string" },
        "form": { "bsonType": "string" },
        "instructions": { "bsonType": "string" },
        "startAt": { "bsonType": ["date", "null"] },
        "endAt": { "bsonType": ["date", "null"] },
        "status": { "enum": ["active", "paused", "stopped", "completed"] },
        "drugRefId": { "bsonType": ["objectId", "null"] },
        "dmplusdCode": { "bsonType": ["string", "null"] },
        "snomedCode": { "bsonType": ["string", "null"] },
        "latestReason": { "bsonType": ["string", "null"] },
        "updatedAt": { "bsonType": "date" },
        "updatedBy": { "bsonType": "string" },
        "lastEventAt": { "bsonType": "date" },
        "lastEventId": { "bsonType": "objectId" }
