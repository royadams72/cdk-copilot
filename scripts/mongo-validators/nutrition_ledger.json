{
  "collMod": "nutrition_ledger",
  "indexes": [
    { "key": { "eatenAt": -1, "patientId": 1 } },
    { "key": { "createdAt": -1, "patientId": 1 } }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": ["patientId", "items", "mealType", "eatenAt", "updatedAt"],
      "properties": {
        "orgId": { "bsonType": "string" },
        "patientId": { "bsonType": "objectId" },
        "items": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": [
              "foodId",
              "quantity",
              "unit",
              "nutrients",
              "name",
              "uid"
            ],
            "properties": {
              "foodId": { "bsonType": "string" },
              "uid": { "bsonType": "string" },
              "name": { "bsonType": "string" },
              "quantity": { "bsonType": ["double", "int"] },
              "unit": { "bsonType": "string" },
              "nutrients": { "bsonType": "object" },
              "brand": { "bsonType": "string" },
              "preparation": { "bsonType": "string" },
              "source": { "enum": ["user", "barcode", "image_ai", "api"] }
            },
            "additionalProperties": true
          }
        },
        "mealType": {
          "enum": ["breakfast", "lunch", "dinner", "snack", "drink"]
        },
        "totals": { "bsonType": "object" },
        "photos": { "bsonType": "array", "items": { "bsonType": "string" } },

        "recipeId": { "bsonType": "string" },
        "tags": { "bsonType": "array", "items": { "bsonType": "string" } },
        "notes": { "bsonType": "string" },
        "eatenAt": { "bsonType": "date" },
        "status": {
          "enum": ["active", "deleted"]
        },

        "deletedAt": { "bsonType": "date" },
        "deletedBy": {
          "enum": ["patient", "clinician", "dietitian", "admin"]
        },

        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" }
      },
      "additionalProperties": true
    }
  }
}
