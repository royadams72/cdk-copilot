{
  "collMod": "nutrition_ledger",
  "indexes": [
    {
      "key": { "patientId": 1, "eatenAt": -1 },
      "options": { "name": "byPatientEatenAt" }
    },
    {
      "key": { "patientId": 1, "createdAt": -1 },
      "options": { "name": "byPatientCreatedAt" }
    },
    {
      "key": { "patientId": 1, "mealType": 1, "eatenAt": -1 },
      "options": { "name": "byPatientMealTypeEatenAt" }
    },
    {
      "key": { "orgId": 1, "patientId": 1, "eatenAt": -1 },
      "options": {
        "name": "byOrgPatientEatenAt",
        "partialFilterExpression": { "orgId": { "$type": "string" } }
      }
    },
    {
      "key": { "orgId": 1, "patientId": 1, "createdAt": -1 },
      "options": {
        "name": "byOrgPatientCreatedAt",
        "partialFilterExpression": { "orgId": { "$type": "string" } }
      }
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": ["patientId", "items", "mealType", "eatenAt", "updatedAt"],
      "properties": {
        "orgId": { "bsonType": "string" },
        "patientId": { "bsonType": "objectId" },
        "items": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": [
              "foodId",
              "quantity",
              "unit",
              "nutrients",
              "name",
              "uid"
            ],
            "properties": {
              "foodId": { "bsonType": "string" },
              "uid": { "bsonType": "string" },
              "name": { "bsonType": "string" },
              "quantity": { "bsonType": ["double", "int"] },
              "unit": { "bsonType": "string" },
              "nutrients": { "bsonType": "object" },
              "brand": { "bsonType": "string" },
              "preparation": { "bsonType": "string" },
              "source": { "enum": ["user", "image_ai", "api"] },
              "taxonomy": {
                "bsonType": "object",
                "required": [
                  "source",
                  "sourceFoodId",
                  "taxonomyKey",
                  "canonicalName",
                  "normalizedName",
                  "majorGroup",
                  "tags",
                  "inferredFrom"
                ],
                "properties": {
                  "source": { "bsonType": "string" },
                  "sourceFoodId": { "bsonType": "string" },
                  "taxonomyKey": { "bsonType": "string" },
                  "canonicalName": { "bsonType": "string" },
                  "normalizedName": { "bsonType": "string" },
                  "majorGroup": { "bsonType": "string" },
                  "subGroup": { "bsonType": ["string", "null"] },
                  "tags": {
                    "bsonType": "array",
                    "items": { "bsonType": "string" }
                  },
                  "inferredFrom": {
                    "bsonType": "object",
                    "required": [
                      "override",
                      "exactName",
                      "keywordRules",
                      "categoryHint",
                      "nutrientTags"
                    ],
                    "properties": {
                      "override": { "bsonType": "bool" },
                      "exactName": { "bsonType": "bool" },
                      "keywordRules": {
                        "bsonType": "array",
                        "items": { "bsonType": "string" }
                      },
                      "categoryHint": { "bsonType": ["string", "null"] },
                      "nutrientTags": {
                        "bsonType": "array",
                        "items": { "bsonType": "string" }
                      }
                    }
                  }
                }
              }
            },
            "additionalProperties": true
          }
        },
        "mealType": {
          "enum": ["breakfast", "lunch", "dinner", "snack", "drink"]
        },
        "totals": { "bsonType": "object" },
        "photos": { "bsonType": "array", "items": { "bsonType": "string" } },

        "recipeId": { "bsonType": "string" },
        "tags": { "bsonType": "array", "items": { "bsonType": "string" } },
        "notes": { "bsonType": "string" },
        "eatenAt": { "bsonType": "date" },
        "status": {
          "enum": ["active", "deleted"]
        },

        "deletedAt": { "bsonType": "date" },
        "deletedBy": {
          "enum": ["patient", "clinician", "dietitian", "admin"]
        },

        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" }
      },
      "additionalProperties": true
    }
  }
}
