{
  "collMod": "food_mappings",
  "indexes": [
    {
      "key": { "source": 1, "barcode": 1 },
      "options": {
        "unique": true,
        "name": "uniqSourceBarcode",
        "partialFilterExpression": {
          "source": { "$type": "string" },
          "barcode": { "$type": "string" }
        }
      }
    },
    {
      "key": { "barcode": 1, "mappingStatus": 1, "source": 1 },
      "options": { "name": "byBarcodeStatusSource" }
    },
    {
      "key": { "mappingStatus": 1, "updatedAt": -1 },
      "options": { "name": "byStatusUpdatedAt" }
    },
    {
      "key": { "normalizedName": 1, "brand": 1 },
      "options": { "name": "byNormalizedNameBrand" }
    },
    {
      "key": { "edamamMatch.foodId": 1 },
      "options": { "name": "byEdamamFoodId" }
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "source",
        "barcode",
        "brand",
        "productName",
        "normalizedName",
        "edamamMatch",
        "confidence",
        "mappingMethod",
        "mappingStatus",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "source": {
          "enum": ["open_food_facts"]
        },
        "barcode": {
          "bsonType": ["string", "null"]
        },
        "brand": {
          "bsonType": ["string", "null"]
        },
        "productName": {
          "bsonType": "string"
        },
        "normalizedName": {
          "bsonType": "string"
        },
        "edamamMatch": {
          "bsonType": "object",
          "required": ["foodId", "foodLabel"],
          "properties": {
            "foodId": { "bsonType": "string" },
            "foodLabel": { "bsonType": "string" }
          }
        },
        "confidence": {
          "enum": ["high", "medium", "low"]
        },
        "mappingMethod": {
          "enum": ["manual", "auto_rule", "auto_similarity", "direct_generic"]
        },
        "mappingStatus": {
          "enum": ["pending", "reviewed", "rejected", "not_needed"]
        },
        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" }
      },
      "additionalProperties": true
    }
  }
}
