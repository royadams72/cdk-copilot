{
  "collMod": "worsening_trend_states",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "body",
        "detail",
        "episodeId",
        "firstDetectedAt",
        "key",
        "lastDetectedAt",
        "level",
        "patientId",
        "portalEscalationEligible",
        "repeatAtLocalTime",
        "repeatUntil",
        "screen",
        "status",
        "title",
        "updatedAt"
      ],
      "properties": {
        "_id": { "bsonType": "objectId" },
        "body": { "bsonType": "string" },
        "detail": { "bsonType": ["string", "null"] },
        "episodeId": { "bsonType": "string" },
        "firstDetectedAt": { "bsonType": "date" },
        "key": {
          "bsonType": "string",
          "enum": [
            "blood_pressure_up",
            "nutrition_worsening",
            "steps_decline",
            "symptoms_worsening",
            "weight_decrease",
            "weight_increase"
          ]
        },
        "lastDetectedAt": { "bsonType": "date" },
        "level": {
          "bsonType": "string",
          "enum": [
            "level_1_nudge",
            "level_2_check_in",
            "level_3_escalate",
            "level_3_high_priority"
          ]
        },
        "patientId": { "bsonType": "objectId" },
        "portalEscalationEligible": { "bsonType": "bool" },
        "repeatAtLocalTime": { "bsonType": ["string", "null"] },
        "repeatUntil": { "bsonType": ["string", "null"] },
        "resolvedAt": { "bsonType": ["date", "null"] },
        "screen": { "bsonType": "string" },
        "status": {
          "bsonType": "string",
          "enum": ["active", "resolved"]
        },
        "title": { "bsonType": "string" },
        "updatedAt": { "bsonType": "date" },
        "viewedAt": { "bsonType": ["date", "null"] }
      },
      "additionalProperties": false
    }
  },
  "validationLevel": "moderate",
  "validationAction": "error",
  "indexes": [
    {
      "key": { "patientId": 1, "episodeId": 1 },
      "options": { "unique": true, "name": "uniq_patient_episode" }
    },
    {
      "key": { "patientId": 1, "key": 1 },
      "options": {
        "unique": true,
        "name": "uniq_patient_active_key",
        "partialFilterExpression": { "status": "active" }
      }
    },
    {
      "key": { "patientId": 1, "status": 1, "updatedAt": -1 },
      "options": { "name": "byPatientStatusUpdatedAt" }
    }
  ]
}
