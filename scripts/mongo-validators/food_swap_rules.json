{
  "collMod": "food_swap_rules",
  "indexes": [
    {
      "key": { "swapGroup": 1, "nutrientFocus": 1 },
      "name": "uniqSwapGroupNutrientFocus",
      "unique": true
    },
    {
      "key": { "swapGroup": 1, "isActive": 1 },
      "name": "bySwapGroupActive"
    },
    {
      "key": { "nutrientFocus": 1, "isActive": 1 },
      "name": "byNutrientFocusActive"
    },
    {
      "key": { "candidateSwapGroups": 1 },
      "name": "byCandidateSwapGroups"
    },
    {
      "key": { "updatedAt": -1 },
      "name": "byUpdatedAtDesc"
    }
  ],
  "validationAction": "error",
  "validationLevel": "moderate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "swapGroup",
        "nutrientFocus",
        "candidateSwapGroups",
        "strategy",
        "isActive",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "swapGroup": { "bsonType": "string" },

        "nutrientFocus": {
          "enum": ["phosphorus", "potassium", "sodium", "protein", "calories"]
        },

        "candidateSwapGroups": {
          "bsonType": "array",
          "minItems": 1,
          "items": { "bsonType": "string" }
        },

        "strategy": {
          "enum": [
            "lower_nutrient_same_role",
            "increase_nutrient_same_role",
            "lower_density_same_role",
            "higher_protein_same_role",
            "lower_calorie_same_role"
          ]
        },

        "preferredFoodIds": {
          "bsonType": ["array", "null"],
          "items": { "bsonType": "objectId" }
        },

        "excludedFoodIds": {
          "bsonType": ["array", "null"],
          "items": { "bsonType": "objectId" }
        },

        "preferredTaxonomyKeys": {
          "bsonType": ["array", "null"],
          "items": { "bsonType": "string" }
        },

        "excludedTaxonomyKeys": {
          "bsonType": ["array", "null"],
          "items": { "bsonType": "string" }
        },

        "minSimilarityScore": {
          "bsonType": ["double", "int", "long", "decimal", "null"],
          "minimum": 0,
          "maximum": 1
        },

        "notes": { "bsonType": ["string", "null"] },

        "tags": {
          "bsonType": ["array", "null"],
          "items": { "bsonType": "string" }
        },

        "isActive": { "bsonType": "bool" },

        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" }
      },
      "additionalProperties": true
    }
  }
}
