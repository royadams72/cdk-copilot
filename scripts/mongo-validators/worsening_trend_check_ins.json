{
  "collMod": "worsening_trend_check_ins",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "alertId",
        "createdAt",
        "key",
        "orgId",
        "patientId",
        "principalId",
        "promptQuestion",
        "responseCode",
        "responseLabel",
        "submittedAt",
        "updatedAt"
      ],
      "properties": {
        "_id": { "bsonType": "objectId" },
        "alertId": { "bsonType": "string" },
        "createdAt": { "bsonType": "date" },
        "key": {
          "bsonType": "string",
          "enum": [
            "blood_pressure_up",
            "nutrition_worsening",
            "steps_decline",
            "symptoms_worsening",
            "weight_decrease",
            "weight_increase"
          ]
        },
        "orgId": { "bsonType": "string" },
        "patientId": { "bsonType": "objectId" },
        "principalId": { "bsonType": "string" },
        "promptQuestion": { "bsonType": "string" },
        "responseCode": { "bsonType": "string" },
        "responseLabel": { "bsonType": "string" },
        "submittedAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" }
      },
      "additionalProperties": false
    }
  },
  "validationLevel": "moderate",
  "validationAction": "error",
  "indexes": [
    {
      "key": { "patientId": 1, "alertId": 1 },
      "options": { "unique": true, "name": "uniq_patient_alert" }
    },
    {
      "key": { "patientId": 1, "submittedAt": -1 },
      "options": { "name": "byPatientSubmittedAt" }
    },
    {
      "key": { "orgId": 1, "patientId": 1, "submittedAt": -1 },
      "options": { "name": "byOrgPatientSubmittedAt" }
    }
  ]
}
