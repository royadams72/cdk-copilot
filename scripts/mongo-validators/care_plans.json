{
  "collMod": "care_plans",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "orgId",
        "patientId",
        "title",
        "status",
        "createdAt",
        "updatedAt",
        "createdBy",
        "updatedBy"
      ],
      "properties": {
        "orgId": { "bsonType": "string" },
        "patientId": { "bsonType": "objectId" },
        "title": { "bsonType": "string" },
        "diagnoses": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "bsonType": "string" },
              "label": { "bsonType": "string" },
              "code": { "bsonType": "string" },
              "codeSystem": { "enum": ["SNOMED_CT", "CUSTOM"] }
            },
            "additionalProperties": true
          }
        },

        "createdBy": {
          "bsonType": "string",
          "description": "principalId"
        },
        "updatedBy": {
          "bsonType": "string",
          "description": "principalId"
        },

        "goals": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": ["key", "label"],
            "properties": {
              "key": { "bsonType": "string" },
              "label": { "bsonType": "string" },
              "target": { "bsonType": "object" }
            },
            "additionalProperties": true
          }
        },
        "tasks": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": ["key", "label", "freq", "status"],
            "properties": {
              "key": { "bsonType": "string" },
              "label": { "bsonType": "string" },
              "freq": { "enum": ["daily", "weekly", "once"] },
              "dueRule": { "bsonType": "string" },
              "instructions": { "bsonType": "string" },
              "status": { "enum": ["open", "paused", "done"] }
            },
            "additionalProperties": true
          }
        },
        "ownerLabels": {
          "bsonType": "array",
          "items": { "bsonType": "string" }
        },
        "reviewLabel": { "bsonType": "string" },
        "status": { "enum": ["draft", "active", "completed", "archived"] },
        "sources": {
          "bsonType": "array",
          "items": { "enum": ["manual", "ai", "template"] }
        },
        "notes": { "bsonType": "string" },
        "activity": {
          "bsonType": "array",
          "items": {
            "bsonType": "object",
            "required": ["key", "type", "at", "by"],
            "properties": {
              "key": { "bsonType": "string" },
              "type": {
                "enum": [
                  "created",
                  "draft_updated",
                  "activated",
                  "reviewed",
                  "completed",
                  "archived",
                  "task_completed",
                  "task_reopened"
                ]
              },
              "at": { "bsonType": "date" },
              "by": { "bsonType": "string" },
              "note": { "bsonType": "string" }
            },
            "additionalProperties": true
          }
        },
        "createdAt": { "bsonType": "date" },
        "updatedAt": { "bsonType": "date" },
        "activatedAt": { "bsonType": "date" },
        "reviewedAt": { "bsonType": "date" },
        "completedAt": { "bsonType": "date" }
      },
      "additionalProperties": true
    }
  },
  "validationLevel": "moderate",
  "validationAction": "error",
  "indexes": [
    { "key": { "orgId": 1, "patientId": 1, "status": 1 } },
    { "key": { "orgId": 1, "status": 1, "updatedAt": -1 } }
  ]
}
