{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@ckd/core": ["packages/core/src/isomorphic/index.ts"],
      "@ckd/core/server": ["packages/core/src/server/index.ts"],
      "core": ["packages/core/src/index.ts"],
      "core/*": ["packages/core/src/*"],
      "networking": ["packages/networking/src/index.ts"],
      "networking/*": ["packages/networking/src/*"],
      "api/*": ["apps/api/*"]
    },
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node"]
  }
}
