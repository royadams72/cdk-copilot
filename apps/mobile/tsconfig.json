{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "baseUrl": ".", // <- make @ resolve from apps/mobile
    "paths": {
      "@/*": ["src/*"],
      "networking": ["../../packages/networking/src/index.ts"],
      "networking/*": ["../../packages/networking/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
