{
  "author": "",
  "dependencies": {
    "fast-xml-parser": "^5.3.6",
    "mongodb": "^6.20.0",
    "sax": "^1.4.4",
    "unzipper": "^0.12.3"
  },
  "description": "",
  "devDependencies": {
    "@next/env": "^16.0.8",
    "@types/node": "^24.5.0",
    "@types/sax": "^1.2.7",
    "@types/unzipper": "^0.10.11",
    "dotenv": "^17.2.3",
    "expo": "~54.0.21",
    "redux-devtools-expo-dev-plugin": "^2.0.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "license": "ISC",
  "main": "index.js",
  "name": "ckd-copilot",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm --filter @ckd/core build && pnpm --filter ./apps/api build",
    "db:apply-validators": "tsx scripts/apply-mongo-validators.ts",
    "ingest:cofid": "tsx scripts/ingest-cofid.ts",
    "ingest:dmd": "tsx scripts/ingest-dmd.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mobile:reverse": "pnpm --filter ./apps/mobile run android:reverse",
    "mobile:dev": "pnpm --filter ./apps/mobile exec expo start --dev-client --localhost",
    "mobile:build:android:debug": "cd apps/mobile/android && ./gradlew assembleDebug",
    "mobile:rebuild:android": "pnpm --filter ./apps/mobile exec expo run:android",
    "mobile:install:android:debug": "adb install -r apps/mobile/android/app/build/outputs/apk/debug/app-debug.apk && adb shell monkey -p com.ckdcopilot.ckdapp -c android.intent.category.LAUNCHER 1",
    "core:build": "pnpm -w --filter @ckd/core run build",
    "api:dev": "pnpm  --filter ./apps/api dev",
    "db:export:nutrition": "mongoexport --uri=\"$MONGODB_URI_APP\" --db=ckd-copilot --collection=nutrition_ledger --out=nutrition_ledger.json"
  },
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
